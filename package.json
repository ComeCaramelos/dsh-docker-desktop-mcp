{
  "name": "@comecaramelos/dsh-docker-desktop-mcp",
  "description": "Independent DSH plugin connecting DeepSeek Harness to the MCP Toolkit in Docker Desktop, with a UI profile picker. Not affiliated with, endorsed by, or sponsored by Docker, Inc.",
  "author": "ComeCaramelos <hello@comecaramelos.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComeCaramelos/dsh-docker-desktop-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ComeCaramelos/dsh-docker-desktop-mcp/issues"
  },
  "homepage": "https://github.com/ComeCaramelos/dsh-docker-desktop-mcp#readme",
  "version": "0.0.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:host": "tsc",
    "build:client": "tsc -p src/client/tsconfig.json && node scripts/build-client.mjs",
    "link:local": "node scripts/link-dev.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@comecaramelos/dsh-ancesters": "^0.0.1",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-0",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@comecaramelos/dsh-mcp-manager": "*",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-0"
  },
  "devDependencies": {
    "@comecaramelos/dsh-mcp-manager": "^0.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "engines": {
    "dsh": "^0.2.0-0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "$@modelcontextprotocol/client"
  }
}
